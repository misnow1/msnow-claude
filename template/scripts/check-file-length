#!/bin/sh
# Fail when a file has more code lines than the limit.
#
# Usage: check-file-length --limit N FILE...
#
# scc counts the code lines. Blank lines and comments do not count. scc counts a Python docstring
# that starts a line as a comment.

usage() {
    echo "usage: check-file-length --limit N FILE..." >&2
    exit 2
}

[ "$1" = "--limit" ] || usage
limit=$2
case $limit in '' | *[!0-9]*) usage ;; esac
shift 2

# Print the number of code lines of the file. Print "none" when scc prints no row for it.
# The header names have no commas, but a path can have one. So read the Code field by its
# position from the end of the row.
code_lines() {
    scc --no-config --no-cocomo --no-size -c --by-file -f csv -- "$1" | awk -F, '
        NR == 1 { for (i = 1; i <= NF; i++) if ($i == "Code") from_end = NF - i; next }
        NR == 2 { rows = 1; if (from_end != "" && NF - from_end >= 1) print $(NF - from_end); else print "?" }
        END { if (!rows) print "none" }
    '
}

# A comment in the first 10 lines that marks a generated file: the Go convention, the output of
# protoc and grpc, and `@generated`. A bare "do not edit" comment does not match.
GENERATED='^[[:space:]]*(//|#|/\*|\*)[[:space:]]*(@generated([^[:alnum:]_]|$)|This file is @generated|Code generated .* DO NOT EDIT|Generated by .* DO NOT EDIT)'
nl='
'

failed=0
for file in "$@"; do
    case $file in
        *"$nl"*)
            printf '%s: the path has a newline, which this check cannot handle\n' "$file"
            failed=1
            continue
            ;;
    esac
    [ -f "$file" ] || continue
    # An empty file or a file of whitespace has 0 code lines. scc may print no row for it.
    LC_ALL=C grep -q -e '[^[:space:]]' -- "$file" || continue
    if head -n 10 -- "$file" | LC_ALL=C grep -E -q -e "$GENERATED"; then
        printf '%s: skipped, generated\n' "$file"
        continue
    fi
    code=$(code_lines "$file")
    case $code in
        none)
            printf '%s: scc counted nothing\n' "$file"
            failed=1
            continue
            ;;
        '' | *[!0-9]*)
            printf '%s: scc gave no code count. Its output layout may have changed.\n' "$file"
            failed=1
            continue
            ;;
    esac
    if [ "$code" -gt "$limit" ]; then
        printf '%s: %s code lines, the limit is %s\n' "$file" "$code" "$limit"
        failed=1
    fi
done
exit $failed
