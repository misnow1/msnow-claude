{% set types = (["python", "pyi"] if "python" in languages else []) + (["go"] if "go" in languages else []) + (["rust"] if "rust" in languages else []) -%}
minimum_pre_commit_version: "4.4.0"
default_install_hook_types: [pre-commit, commit-msg]
repos:
  - repo: local
    hooks:
      - id: length
        name: file length
        stages: [pre-commit]
{%- if types %}
        language: golang
        language_version: 1.26.4
        additional_dependencies: ["github.com/boyter/scc/v4@v4.1.0"]
        entry: sh scripts/check-file-length
        args: ["--limit", "500"]
        exclude: '(^|/)(_?vendor|third_party|node_modules)/'
        types_or: [{{ types | join(", ") }}]
{%- else %}
        language: unsupported
        entry: "true"
        files: '^$'
{%- endif %}
